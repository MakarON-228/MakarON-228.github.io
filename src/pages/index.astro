---
// Временная заглушка этапа 0: проверка шрифтов, токенов и тем. Этап 1 заменит её контентом из resume.ts.
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const swatches = ['paper', 'surface', 'ink', 'muted', 'rule', 'line-science', 'line-rail', 'line-agents', 'line-craft'];
---

<Base title="Makar Glazachev" description="Work in progress.">
  <header class="bar">
    <ThemeToggle />
  </header>
  <main id="content" class="page">
    <h1 class="display">Display 0123</h1>
    <p class="body">Body text — Overpass <strong>600</strong>. Placeholder for stage 0.</p>
    <p class="mono">Data 0123456789 · tabular-nums</p>
    <ul class="swatches">
      {swatches.map((s) => <li style={`--c: var(--${s})`}><code>--{s}</code></li>)}
    </ul>
  </main>
</Base>

<style>
  .bar {
    display: flex;
    justify-content: flex-end;
    padding: var(--space-4) var(--gutter);
  }

  .page {
    display: grid;
    gap: var(--space-6);
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-8) var(--gutter) var(--space-16);
  }

  .display {
    font-size: var(--fs-name);
    font-weight: 800;
  }

  .body {
    font-size: var(--fs-18);
  }

  .mono {
    font-family: var(--font-mono);
    color: var(--line-science);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-14);
  }

  .swatches li {
    padding: var(--space-3);
    padding-top: var(--space-12);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: var(--space-8) solid var(--c);
    border-radius: var(--radius);
  }
</style>
