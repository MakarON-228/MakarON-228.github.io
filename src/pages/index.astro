---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import RailMap from '../islands/RailMap/RailMap.astro';
import { experience, hackathons, header, projects, sections } from '../data/resume';

const title = Object.fromEntries(sections.map((s) => [s.id, s.label])) as Record<(typeof sections)[number]['id'], string>;
---

<Base title={`${header.name} — ${header.role}`} description={header.summary}>
  <SiteNav />
  <main id="content" class="page" tabindex="-1">
    <Hero />

    <Section id="experience" title={title.experience}>
      <div class="entries">
        {experience.map((e) => <Entry entry={e}>{e.id === 'tmh-internship' && <RailMap />}</Entry>)}
      </div>
    </Section>

    <Section id="hackathons" title={title.hackathons}>
      <span slot="aside" class="tally">{hackathons.tally}</span>
      <div class="entries">{hackathons.items.map((e) => <Entry entry={e} />)}</div>
    </Section>

    <Section id="projects" title={title.projects}>
      <div class="entries">{projects.map((e) => <Entry entry={e} />)}</div>
    </Section>

    <Section id="education" title={title.education}>
      <Education />
    </Section>

    <Section id="skills" title={title.skills}>
      <Skills />
    </Section>

    <Section id="contact" title={title.contact}>
      <Contact />
    </Section>
  </main>
  <Footer />
</Base>

<style>
  .page {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .page:focus {
    outline: none;
  }

  .entries {
    display: grid;
    gap: var(--space-12);
  }

  /* Капсула «3 entered · 3 won» — одна на весь сайт (SPEC.md §4) */
  .tally {
    padding: 0.15rem var(--space-3);
    border: 2px solid var(--line-science);
    border-radius: 999px;
    color: var(--line-science);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    font-weight: 600;
    white-space: nowrap;
  }
</style>
