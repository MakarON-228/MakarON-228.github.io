---
// Страница 404 (SPEC.md §8, этап 5): линия обрывается, следующей станции на схеме нет. Без навигации по якорям —
// её ссылки ведут в секции главной страницы.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { header, ui } from '../data/resume';

const t = ui.notFound;
---

<Base title={`${t.title} — ${header.name}`} description={t.text} noindex>
  <main id="content" class="page" tabindex="-1">
    <svg class="scheme" viewBox="0 0 320 48" aria-hidden="true" focusable="false">
      <line class="track" x1="4" y1="24" x2="200" y2="24"></line>
      <line class="buffer" x1="200" y1="10" x2="200" y2="38"></line>
      <circle class="stop" cx="96" cy="24" r="10"></circle>
      <circle class="missing" cx="268" cy="24" r="12"></circle>
    </svg>
    <p class="code">404</p>
    <h1>{t.title}</h1>
    <p class="text">{t.text}</p>
    <a class="home" href="/"><span aria-hidden="true">←</span> {t.home}</a>
  </main>
  <Footer />
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-16) var(--gutter) 0;
  }

  .page:focus {
    outline: none;
  }

  .scheme {
    width: 100%;
    max-width: 20rem;
    height: auto;
    margin-bottom: var(--space-4);
  }

  .track,
  .buffer {
    stroke: var(--line-science);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .stop {
    fill: var(--surface);
    stroke: var(--line-science);
    stroke-width: 4;
  }

  /* Станции, которой нет: пустой пунктирный круг за концом линии */
  .missing {
    fill: none;
    stroke: var(--muted);
    stroke-width: 3;
    stroke-dasharray: 5 5;
  }

  .code {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-18);
  }

  h1 {
    font-size: var(--fs-64);
    font-weight: 800;
    text-transform: uppercase;
  }

  .text {
    font-size: var(--fs-18);
  }

  .home {
    margin-top: var(--space-4);
    font-weight: 600;
  }
</style>
