---
import type { Entry } from '../data/resume';
import { ui } from '../data/resume';
import Rich from './Rich.astro';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const meta = [entry.role, entry.place, ...(entry.stack ?? [])].filter((m): m is string => Boolean(m));
---

<article class="entry" id={entry.id} style={`--line: var(--line-${entry.line})`}>
  <div class="rail" aria-hidden="true"><span class="stop"></span></div>
  <div class="when">
    <time>{entry.date}</time>
  </div>
  <div class="what">
    <h3>
      {entry.title}{entry.result && <span class="result">{' — '}{entry.result}</span>}
    </h3>
    {meta.length > 0 && <p class="meta">{meta.map((m) => <span class="dot-sep">{m}</span>)}</p>}
    {entry.intro && <p class="intro"><Rich text={entry.intro} /></p>}
    {entry.body && <p><Rich text={entry.body} /></p>}
    {
      entry.bullets && (
        <ul>
          {entry.bullets.map((b) => (
            <li>
              <Rich text={b} />
            </li>
          ))}
        </ul>
      )
    }
    {
      entry.repo && (
        <p class="repo">
          <span class="visually-hidden">{ui.repo}: </span>
          <a href={entry.repo.href}>{entry.repo.label}</a>
        </p>
      )
    }
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    grid-template-areas:
      'rail when'
      'rail what';
    column-gap: var(--space-4);
    row-gap: var(--space-1);
  }

  .rail {
    grid-area: rail;
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* Отрезок линии проекта, станция — кружок с обводкой цветом линии */
  .rail::before {
    content: '';
    position: absolute;
    top: 0.35rem;
    bottom: calc(-1 * var(--space-12));
    width: 6px;
    background: var(--line);
    border-radius: 3px;
  }

  .entry:last-child .rail::before {
    bottom: 0;
  }

  .stop {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    background: var(--surface);
    border: 4px solid var(--line);
    border-radius: 50%;
  }

  .when {
    grid-area: when;
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--muted);
    line-height: 1.6;
  }

  .what {
    grid-area: what;
    display: grid;
    gap: var(--space-3);
  }

  h3 {
    font-size: var(--fs-28);
    font-weight: 700;
  }

  .result {
    color: var(--muted);
    font-weight: 700;
  }

  .meta {
    font-weight: 600;
  }

  .intro {
    color: var(--muted);
  }

  ul {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    margin: 0;
    padding-left: 1.1em;
  }

  li::marker {
    color: var(--muted);
  }

  .repo {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    overflow-wrap: anywhere;
  }

  @media (min-width: 960px) {
    .entry {
      grid-template-columns: 7rem 1.5rem minmax(0, 1fr);
      grid-template-areas: 'when rail what';
    }

    .when {
      text-align: right;
      padding-top: 0.2rem;
    }
  }
</style>
