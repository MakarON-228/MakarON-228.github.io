---
// Сворачиваемая рамка демки под записью (SPEC.md §7): в покое остаётся компактная
// «станция» с названием, бейджем и явным действием. Нативный details работает без JS и с клавиатуры.
import { ui } from '../data/resume';

interface Props {
  /** Префикс id заголовка. */
  id: string;
  title: string;
  badge: string;
  caption: string;
  class?: string;
}

const { id, title, badge, caption, class: className } = Astro.props;
---

<figure class:list={['demo', className]} aria-labelledby={`${id}-title`}>
  <details>
    <summary>
      <span class="track" aria-hidden="true"><span class="station"></span></span>
      <span class="heading">
        <span class="eyebrow">{ui.demoDisclosure.label}</span>
        <span class="title" id={`${id}-title`}>{title}</span>
      </span>
      <span class="meta">
        <span class="badge">{badge}</span>
        <span class="action">
          <span class="action-open">{ui.demoDisclosure.open}</span>
          <span class="action-close">{ui.demoDisclosure.close}</span>
          <span class="chevron" aria-hidden="true"></span>
        </span>
      </span>
    </summary>
    <div class="body">
      <slot />
      <figcaption>{caption}</figcaption>
    </div>
  </details>
</figure>

<style>
  .demo {
    --demo-line: var(--line-science);

    min-width: 0;
    margin: var(--space-4) 0 0;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-inline-start: 3px solid var(--demo-line);
    border-radius: var(--radius);
    overflow: clip;
  }

  .demo.railmap,
  .demo.twomodels {
    --demo-line: var(--line-rail);
  }

  .demo.agentpipeline {
    --demo-line: var(--line-agents);
  }

  .demo.routefinder,
  .demo.pitchstaff {
    --demo-line: var(--line-craft);
  }

  details,
  .heading {
    min-width: 0;
  }

  summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: calc(var(--radius) - 1px);
    cursor: pointer;
    list-style: none;
    transition: background-color 160ms ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::marker {
    content: '';
  }

  summary:hover {
    background: color-mix(in srgb, var(--demo-line) 7%, var(--surface));
  }

  summary:focus-visible {
    outline-offset: -4px;
  }

  details[open] summary {
    background: color-mix(in srgb, var(--demo-line) 5%, var(--surface));
    border-end-start-radius: 0;
    border-end-end-radius: 0;
  }

  .track {
    position: relative;
    display: grid;
    width: 2rem;
    height: 2.75rem;
    place-items: center;
  }

  .track::before {
    position: absolute;
    inset-block: 0;
    width: 3px;
    background: var(--demo-line);
    content: '';
  }

  .station {
    z-index: 1;
    width: 0.9rem;
    height: 0.9rem;
    background: var(--surface);
    border: 3px solid var(--demo-line);
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--surface);
    transition: background-color 160ms ease, transform 160ms ease;
  }

  details[open] .station {
    background: var(--demo-line);
    transform: scale(1.08);
  }

  .heading {
    display: grid;
    gap: var(--space-1);
  }

  .eyebrow {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    line-height: 1.2;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--fs-28);
    font-weight: 700;
    line-height: var(--lh-tight);
    text-wrap: balance;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2) var(--space-3);
  }

  .badge {
    padding: 0.1rem var(--space-2);
    border: 1px solid var(--muted);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    white-space: nowrap;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--line-science);
    font-weight: 600;
    white-space: nowrap;
  }

  .action-close {
    display: none;
  }

  details[open] .action-open {
    display: none;
  }

  details[open] .action-close {
    display: inline;
  }

  .chevron {
    width: 0.55rem;
    height: 0.55rem;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    transform: translateY(-0.12rem) rotate(45deg);
    transition: transform 160ms ease;
  }

  details[open] .chevron {
    transform: translateY(0.12rem) rotate(225deg);
  }

  .body {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-4);
    border-block-start: 1px solid var(--rule);
    animation: reveal 180ms ease-out;
  }

  figcaption {
    max-width: var(--measure);
    color: var(--muted);
    font-size: var(--fs-14);
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 639px) {
    summary {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-2) var(--space-3);
      padding: var(--space-3);
    }

    .track {
      grid-row: 1 / span 2;
      height: 100%;
      min-height: 3.5rem;
    }

    .title {
      font-size: var(--fs-22);
    }

    .meta {
      grid-column: 2;
      justify-content: flex-start;
    }

    .body {
      padding: var(--space-3);
    }

    .action {
      font-size: var(--fs-14);
    }
  }
</style>
