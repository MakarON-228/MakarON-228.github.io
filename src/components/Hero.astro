---
import { Picture } from 'astro:assets';
import { header, ui } from '../data/resume';
import TransitMap from '../islands/TransitMap/TransitMap.astro';
import portrait from '../assets/makar-portrait.jpg';

// Размер круга с фото — он же в CSS (--photo): от телефона до широкого экрана.
const photoSize = 'clamp(72px, 12vw, 176px)';
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Имя и фото — две колонки: на узком экране имя переносится само и на фото не наезжает -->
  <div class="name">
    <h1 id="hero-title">{header.name}</h1>
    <Picture
      src={portrait}
      alt={ui.photoAlt}
      formats={['avif', 'webp']}
      widths={[72, 144, 176, 300]}
      sizes={photoSize}
      loading="eager"
      decoding="async"
      class="photo"
    />
  </div>
  <div class="intro">
    <p class="role">{header.role}</p>
    <p class="summary">{header.summary}</p>

    <ul class="contacts">
      <li class="email">
        <span class="label">{ui.email}</span>
        <a href={`mailto:${header.email}`}>{header.email}</a>
        <!-- Место под кнопку занято с первой отрисовки; видимой её делает скрипт, если есть буфер обмена -->
        <button type="button" class="copy" data-copy={header.email} data-pending>{ui.copy}</button>
        <span class="status" role="status" aria-live="polite" data-copied={ui.copied} data-failed={ui.copyFailed}></span>
      </li>
      <li>
        <span class="label">{ui.telegram}</span>
        <a href={header.telegram.href}>{header.telegram.label}</a>
      </li>
      <li>
        <span class="label">{ui.github}</span>
        <a href={header.github.href}>{header.github.label}</a>
      </li>
    </ul>

    <p class="where">{[header.location, ...header.languages].map((part) => <span class="dot-sep">{part}</span>)}</p>

    <a class="cv" href={header.cv} download>{ui.downloadCv} <span aria-hidden="true">↓</span></a>
  </div>
  <div class="map">
    <TransitMap />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-12) var(--space-8);
  }

  .map {
    margin-top: var(--space-6);
  }

  .name {
    --photo: clamp(72px, 12vw, 176px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--photo);
    align-items: center;
    gap: var(--space-3);
  }

  /* Фото — станция: круг с зазором цвета поверхности и обводкой цветом линии */
  .name :global(.photo) {
    width: var(--photo);
    height: var(--photo);
    padding: 3px;
    background: var(--surface);
    border: 4px solid var(--line-science);
    border-radius: 50%;
    object-fit: cover;
  }

  .intro {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    align-content: start;
  }

  /* Широкий экран: имя во всю ширину, ниже текст слева и карта справа — всё на первом экране */
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      column-gap: var(--space-12);
    }

    .name {
      grid-column: 1 / -1;
    }

    .map {
      align-self: center;
      margin-top: 0;
    }
  }

  h1 {
    font-size: var(--fs-name);
    font-weight: 800;
    line-height: 0.92;
    text-transform: uppercase;
    letter-spacing: -0.005em;
  }

  /* Акцентный брусок под именем, как в CV */
  h1::after {
    content: '';
    display: block;
    width: 4.5rem;
    height: 6px;
    margin-top: var(--space-4);
    background: var(--line-science);
  }

  .role {
    font-family: var(--font-display);
    font-size: var(--fs-28);
    font-weight: 700;
    color: var(--line-science);
  }

  .summary {
    font-size: var(--fs-18);
    max-width: 52ch;
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--fs-14);
  }

  .contacts li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    min-width: 0;
  }

  .contacts a {
    overflow-wrap: anywhere;
  }

  .label {
    color: var(--muted);
  }

  .copy {
    padding: 0.1rem var(--space-2);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-size: var(--fs-14);
    cursor: pointer;
  }

  .copy:hover {
    border-color: var(--ink);
  }

  .copy[data-pending] {
    visibility: hidden;
  }

  .status:empty {
    display: none;
  }

  .status {
    color: var(--muted);
  }

  .where {
    color: var(--muted);
  }

  .cv {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-6);
    background: var(--line-science);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: var(--fs-22);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: var(--radius);
  }

  .cv:hover {
    background: var(--ink);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    if (!navigator.clipboard) return;
    const status = button.parentElement?.querySelector<HTMLElement>('.status');
    delete button.dataset['pending'];
    button.addEventListener('click', async () => {
      if (!status) return;
      try {
        await navigator.clipboard.writeText(button.dataset['copy'] ?? '');
        status.textContent = status.dataset['copied'] ?? '';
      } catch {
        status.textContent = status.dataset['failed'] ?? '';
      }
    });
  });
</script>
