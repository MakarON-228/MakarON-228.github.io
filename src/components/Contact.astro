---
import { header, ui } from '../data/resume';

const channels = [
  { label: ui.email, text: header.email, href: `mailto:${header.email}` },
  { label: ui.telegram, text: header.telegram.label, href: header.telegram.href },
  { label: ui.github, text: header.github.label, href: header.github.href },
];
---

<div class="contact">
  <p class="lead">{ui.contactLead}</p>
  <ul>
    {
      channels.map((c) => (
        <li>
          <span class="label">{c.label}</span>
          <a href={c.href}>{c.text}</a>
        </li>
      ))
    }
  </ul>
  <a class="cv" href={header.cv} download>{ui.downloadCv} <span aria-hidden="true">↓</span></a>
</div>

<style>
  .contact {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .lead {
    font-family: var(--font-display);
    font-size: var(--fs-40);
    font-weight: 700;
    line-height: var(--lh-tight);
  }

  ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: 0 var(--space-4);
  }

  .label {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--muted);
  }

  a:not(.cv) {
    font-size: var(--fs-22);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .cv {
    padding: var(--space-3) var(--space-6);
    border: 2px solid var(--line-science);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: var(--fs-22);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
  }

  .cv:hover {
    background: var(--line-science);
    color: var(--paper);
  }

  @media (min-width: 720px) {
    li {
      grid-template-columns: 6rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
</style>
