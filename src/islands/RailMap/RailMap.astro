---
// Демо RailMap (SPEC.md §7.4): все станции России по дорогам на открытых данных OSM.
// Заглушка собирается здесь из тех же файлов, что потом загрузит карта, — в той же проекции и рамке.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { RailwaysFile, StationsFile } from '../../../scripts/stations/format';
import DemoFigure from '../../components/DemoFigure.astro';
import { ui } from '../../data/resume';
import RailMapApp from './RailMap.svelte';
import { decode, formatDate } from './model';
import { roadToken } from './palette';
import { landPath, stationPaths, type LandCollection } from './placeholder';
import { VIEW, frame } from './projection';

const read = <T,>(name: string) => JSON.parse(readFileSync(join(process.cwd(), 'public/data', name), 'utf8')) as T;
const railways = read<RailwaysFile>('railways.json');
const points = decode(read<StationsFile>('stations.json'));
const land = read<LandCollection>('land.json');

const f = frame(VIEW, 720);
const width = f.width;
const height = Math.round(f.height);
const paths = stationPaths(points, f, 3);
const groups = railways.groups.map(({ id, nameEn, stations, halts }) => ({ id, nameEn, stations, halts }));
const t = ui.railMap;
---

<DemoFigure id="railmap" class="railmap" title={t.title} badge={t.badge} caption={t.caption(formatDate(railways.extracted))}>
  <RailMapApp client:visible groups={groups} stationsUrl="/data/stations.json" landUrl="/data/land.json">
    <svg class="placeholder" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
      <path class="land" d={landPath(land, 'land', f, 1.5, 10)}></path>
      <path class="lake" d={landPath(land, 'lake', f, 1.5, 10)}></path>
      {paths.map((p) => <path class="stations" d={p.d} style={`stroke: var(${roadToken(groups[p.group]!.id)})`} />)}
    </svg>
  </RailMapApp>
  <!-- Без JS поиск и платформы не работают — их не показываем; список дорог остаётся легендой -->
  <noscript><style is:inline>.railmap .tools { display: none; }</style></noscript>
</DemoFigure>

<style>
  .land {
    fill: var(--map-land);
  }

  .lake {
    fill: var(--map-water);
  }

  .stations {
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
  }
</style>
