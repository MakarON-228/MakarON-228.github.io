---
// Табло (SPEC.md §7.2): реальные цифры из resume.ts. Значения всегда видны; перещёлкивание — только по действию.
import { board, entries, ui } from '../../data/resume';

const valueCells = Math.max(...board.map((r) => r.value.length));
const labelCells = Math.max(...board.map((r) => r.label.length));
const cell = (ch: string) => (ch === ' ' ? '\u00a0' : ch);

const rows = board.map((r) => {
  const entry = entries.find((e) => e.id === r.entry)!;
  return {
    ...r,
    line: entry.line,
    station: entry.station,
    value: r.value.padStart(valueCells),
    label: r.label.padEnd(labelCells),
    labelLength: r.label.length,
    spoken: `${r.value} ${r.label} — ${entry.station}`,
  };
});
---

<section class="board" id="board" aria-labelledby="board-title" data-board>
  <div class="head">
    <h2 id="board-title">{ui.board.title}</h2>
    <button type="button" class="flip" data-flip hidden>{ui.board.flip}</button>
  </div>

  <div class="table">
    <div class="columns" aria-hidden="true">
      <span class="c-value">{ui.board.figure}</span>
      <span class="c-label">{ui.board.what}</span>
      <span class="c-from">{ui.board.from}</span>
    </div>

    <ol class="rows">
      {
        rows.map((r) => (
          <li class="row" style={`--c: var(--line-${r.line})`} data-target={`${r.value}${r.label}`}>
            <span class="visually-hidden">{r.spoken}</span>
            <span class="cells value" aria-hidden="true">
              {Array.from(r.value).map((ch) => (
                <span class="cell">
                  <span class="glyph">{cell(ch)}</span>
                </span>
              ))}
            </span>
            <span class="cells label" aria-hidden="true">
              {Array.from(r.label).map((ch, i) => (
                <span class={i < r.labelLength ? 'cell' : 'cell pad'}>
                  <span class="glyph">{cell(ch)}</span>
                </span>
              ))}
            </span>
            <span class="from" aria-hidden="true">
              <span class="dot" />
              {r.station}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .board {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-4);
    background: var(--board-bg);
    color: var(--board-ink);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .board :focus-visible {
    outline-color: var(--board-accent);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  h2 {
    font-size: var(--fs-28);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .flip {
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    background: transparent;
    color: var(--board-ink);
    border: 1px solid var(--board-muted);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    cursor: pointer;
  }

  .flip:hover {
    border-color: var(--board-ink);
  }

  .columns {
    display: none;
    color: var(--board-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .rows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'value from'
      'label label';
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    border-top: 1px solid var(--board-seam);
    cursor: default;
  }

  .cells {
    display: flex;
    gap: 2px;
    font-family: var(--font-mono);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
    line-height: 1;
  }

  .value {
    grid-area: value;
    font-size: clamp(1.25rem, 4.5vw, 1.75rem);
    color: var(--board-accent);
  }

  .label {
    grid-area: label;
    font-size: clamp(0.75rem, 2.6vw, 1rem);
  }

  /* Ячейка с «швом» посередине, как у перекидного табло */
  .cell {
    display: inline-grid;
    place-items: center;
    inline-size: calc(1ch + 0.4em);
    block-size: 1.45em;
    background: linear-gradient(
      var(--board-cell) 0 calc(50% - 0.5px),
      var(--board-seam) 0 calc(50% + 0.5px),
      var(--board-cell) 0
    );
    border-radius: 3px;
    perspective: 8em;
  }

  .glyph {
    display: block;
    transform-origin: 50% 50%;
  }

  .pad {
    display: none;
  }

  .from {
    grid-area: from;
    display: flex;
    align-items: center;
    justify-self: end;
    gap: var(--space-2);
    color: var(--board-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    text-align: right;
  }

  .dot {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    background: var(--c);
    border-radius: 50%;
    /* светлый ободок: тёмно-синяя Science иначе теряется на тёмном табло */
    box-shadow: 0 0 0 1.5px var(--board-muted);
  }

  /* Широкий экран: одна таблица на subgrid — заголовки колонок и все строки выровнены */
  @media (min-width: 720px) {
    .board {
      padding: var(--space-6) var(--space-8);
    }

    .table {
      display: grid;
      grid-template-columns: auto auto minmax(0, 1fr);
      column-gap: var(--space-6);
    }

    .columns,
    .rows,
    .row {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      grid-template-areas: none;
    }

    .columns {
      padding-bottom: var(--space-2);
    }

    .value,
    .label,
    .from {
      grid-area: auto;
    }

    .from {
      justify-self: start;
      text-align: left;
    }

    .pad {
      display: inline-grid;
    }
  }
</style>

<script>
  import { initBoard } from './client';

  document.querySelectorAll<HTMLElement>('[data-board]').forEach(initBoard);
</script>
